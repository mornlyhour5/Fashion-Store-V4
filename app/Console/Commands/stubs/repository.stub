    }

    public function update({{ name }} ${{ name }}, array $data)
    {
        ${{ name }}->update($data);

        return ${{ name }}->fresh();
    }

    public function delete({{ name }} ${{ name }})
    {
        return ${{ name }}->delete();
    }
}
